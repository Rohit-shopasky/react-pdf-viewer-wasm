{
  "name": "react-pdf-viewer-wasm",
  "version": "0.1.3",
  "description": "A React PDF viewer powered by Rust + WebAssembly, using pdfium as the rendering backend.",
  "type": "module",
  "main": "./dist/index.mjs",
